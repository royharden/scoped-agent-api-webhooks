{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m14.invalid/contracts/v1/task.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "m14.task.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "enum": [
              "list",
              "get",
              "create",
              "edit",
              "submit",
              "approve",
              "close",
              "cancel"
            ]
          },
          "arguments": {
            "type": "object"
          },
          "expected_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "operation",
          "arguments",
          "expected_version",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    "consent_fixture_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "steps",
    "consent_fixture_id"
  ],
  "additionalProperties": false,
  "description": "Developer task syntax only. Server authorization and operation-specific validation remain authoritative; task consent text confers no authority."
}
